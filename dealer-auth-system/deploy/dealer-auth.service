[Unit]
Description=Dealer Authorization Query System (gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=dealerapp
Group=dealerapp
WorkingDirectory=/opt/dealer-auth-system
EnvironmentFile=/opt/dealer-auth-system/.env
ExecStart=/opt/dealer-auth-system/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 --timeout 30 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
