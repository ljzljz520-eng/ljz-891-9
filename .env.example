# ============================================
# 品牌经销资质查询系统 - 环境配置
# 复制为 .env 并修改为实际值
# ============================================

# 服务端口
PORT=3000

# 运行环境: development | production
NODE_ENV=production

# 数据库类型: mysql | sqlite
# sqlite 仅用于快速体验/演示，生产环境请使用 mysql
DB_DIALECT=mysql

# ---- MySQL 数据库配置（DB_DIALECT=mysql 时生效）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dealer_qualification
DB_USER=dealer_app
DB_PASSWORD=your_strong_password_here

# ---- SQLite 配置（DB_DIALECT=sqlite 时生效）----
# SQLite 数据库文件路径
SQLITE_PATH=./data/dealer.db

# 数据库连接池（可选）
DB_POOL_MAX=10
DB_POOL_MIN=2

# JWT 密钥（务必修改为随机长字符串）
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=12h

# ---- 邮件 SMTP 配置 ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=品牌资质查询系统 <noreply@example.com>

# 系统名称（显示在邮件和页面标题）
SYSTEM_NAME=品牌经销资质查询系统

# 初始超级管理员（仅在首次初始化数据库时创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_EMAIL=admin@example.com
